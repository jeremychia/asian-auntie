# Flask
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-real-secret

# JWT — must be different from FLASK_SECRET_KEY
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-different-secret

# Database — leave as SQLite for local dev; set to Render's PostgreSQL URL in prod
DATABASE_URL=sqlite:///app.db

# OpenAI Vision API — leave blank to use stub mode (app works without it)
OPENAI_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development or production
FLASK_ENV=development

# CORS allowed origins — comma-separated, no spaces
# In production: set to your Render domain, e.g. https://asian-auntie.onrender.com
ALLOWED_ORIGINS=http://localhost:8080

# Google Cloud Storage — set GCS_BUCKET_NAME to store photos in GCS
# Leave blank to fall back to local filesystem (local dev without GCS)
GCS_BUCKET_NAME=asian-auntie-items-dev
# Local dev: point to your service account key file (GCS client reads this automatically)
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json
# Production (Render): paste the key file contents as a single-line JSON string instead
# python -c "import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))" gcp-service-account.json
GCS_CREDENTIALS_JSON=

# Open Food Facts contribution credentials (optional — only needed to contribute data back)
# Use https://world.openfoodfacts.net for sandbox testing
OFF_USERNAME=
OFF_PASSWORD=
OFF_API_URL=https://world.openfoodfacts.org
